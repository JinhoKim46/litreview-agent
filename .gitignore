# Per-review state: everything under results/<TOPIC>/ is one reviewer's
# working data (search results, screening decisions, extracted data,
# manuscript drafts). Keep the schema documented and the directory structure
# creatable, but never track a reviewer's actual content.
results/**
!results/**/.gitkeep
!results/**/README.md

# Secrets (optional NCBI_API_KEY / S2_API_KEY connector credentials)
.env
.env.*

# Reviewer profile (name, institution, prior work) -- personal, not for a public fork's git history.
# CLAUDE.local.md.example (the template) stays tracked.
CLAUDE.local.md

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/

# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Claude Code user-specific memory and session runtime state (not project state)
.claude/projects/
.claude/scheduled_tasks.lock

# Root-level only (leading slash) -- this must NOT also match
# .claude/skills/prisma-manuscript/references/, which is shipped framework
# content (the CC BY 4.0 PRISMA checklist/flow-diagram + APA7 rules), not
# local development source material.
/references/
